    {
      "test_id": "API-CART-09",
      "oracle": "AC-002.3",
      "title": "Merged add that would exceed the 10-per-line limit is rejected",
      "steps": [
        {
          "name": "Add P-1 quantity 6",
          "request": {
            "method": "POST",
            "path": "/cart/items",
            "body": {
              "product_id": "P-1",
              "quantity": 6
            }
          },
          "expect": {
            "status": 201,
            "json": [
              {
                "path": "$.quantity",
                "equals": 6
              }
            ]
          }
        },
        {
          "name": "Add P-1 quantity 5 (combined 11)",
          "request": {
            "method": "POST",
            "path": "/cart/items",
            "body": {
              "product_id": "P-1",
              "quantity": 5
            }
          },
          "expect": {
            "status": 400,
            "json": [
              {
                "path": "$.error",
                "equals": "invalid_quantity"
              }
            ]
          }
        },
        {
          "name": "Get cart and verify line unchanged at 6",
          "request": {
            "method": "GET",
            "path": "/cart"
          },
          "expect": {
            "status": 200,
            "json": [
              {
                "path": "$.items",
                "length": 1
              },
              {
                "path": "$.items[0].product_id",
                "equals": "P-1"
              },
              {
                "path": "$.items[0].quantity",
                "equals": 6
              }
            ]
          }
        }
      ]
