{
  "schema": "qa.apitests.v1",
  "project": "demo-shop",
  "tests": [
    {
      "test_id": "API-CART-01",
      "oracle": "AC-001.1",
      "title": "Get product catalogue returns required fields",
      "steps": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "path": "/products"
          },
          "expect": {
            "status": 200,
            "json": [
              {
                "path": "$",
                "length": 4
              },
              {
                "path": "$[0].id",
                "exists": true
              },
              {
                "path": "$[0].name",
                "exists": true
              },
              {
                "path": "$[0].price",
                "exists": true
              },
              {
                "path": "$[0].stock",
                "exists": true
              },
              {
                "path": "$[1].id",
                "exists": true
              },
              {
                "path": "$[1].name",
                "exists": true
              },
              {
                "path": "$[1].price",
                "exists": true
              },
              {
                "path": "$[1].stock",
                "exists": true
              },
              {
                "path": "$[2].id",
                "exists": true
              },
              {
                "path": "$[2].name",
                "exists": true
              },
              {
                "path": "$[2].price",
                "exists": true
              },
              {
                "path": "$[2].stock",
                "exists": true
              },
              {
                "path": "$[3].id",
                "exists": true
              },
              {
                "path": "$[3].name",
                "exists": true
              },
              {
                "path": "$[3].price",
                "exists": true
              },
              {
                "path": "$[3].stock",
                "exists": true
              }
            ]
          }
        }
      ]
    },
    {
      "test_id": "API-CART-02",
      "oracle": "AC-001.2",
      "title": "Catalogue includes out-of-stock products",
      "steps": [
        {
          "name": "List products and confirm zero-stock product present",
          "request": {
            "method": "GET",
            "path": "/products"
          },
          "expect": {
            "status": 200,
            "json": [
              {
                "path": "$",
                "contains": {
                  "id": "P-4",
                  "stock": 0
                }
              }
            ]
          }
        }
      ]
    },
    {
      "test_id": "API-CART-03",
      "oracle": "AC-001.3",
      "title": "Product prices are exact numeric cent values",
      "steps": [
        {
          "name": "List products and verify exact cent prices",
          "request": {
            "method": "GET",
            "path": "/products"
          },
          "expect": {
            "status": 200,
            "json": [
              {
                "path": "$[0].price",
                "equals": 4.99
              },
              {
                "path": "$[1].price",
                "equals": 1.25
              },
              {
                "path": "$[2].price",
                "equals": 39.99
              },
              {
                "path": "$[3].price",
                "equals": 15.5
              }
            ]
          }
        }
      ]
    },
    {
      "test_id": "API-CART-04",
      "oracle": "AC-002.1",
      "title": "Add new product to empty cart with minimum quantity",
      "steps": [
        {
          "name": "Add P-1 quantity 1",
          "request": {
            "method": "POST",
            "path": "/cart/items",
            "body": {
              "product_id": "P-1",
              "quantity": 1
            }
          },
          "expect": {
            "status": 201,
            "json": [
              {
                "path": "$.product_id",
                "equals": "P-1"
              },
              {
                "path": "$.quantity",
                "equals": 1
              },
              {
                "path": "$.line_total",
                "equals": 4.99
              }
            ]
          }
        }
      ]
    },
    {
      "test_id": "API-CART-05",
      "oracle": "AC-002.2",
      "title": "Adding the same product twice merges into one line",
      "steps": [
        {
          "name": "Add P-1 quantity 2",
          "request": {
            "method": "POST",
            "path": "/cart/items",
            "body": {
              "product_id": "P-1",
              "quantity": 2
            }
          },
          "expect": {
            "status": 201
          }
        },
        {
          "name": "Add P-1 quantity 3 again",
          "request": {
            "method": "POST",
            "path": "/cart/items",
            "body": {
              "product_id": "P-1",
              "quantity": 3
            }
          },
          "expect": {
            "status": 201,
            "json": [
              {
                "path": "$.product_id",
                "equals": "P-1"
              },
              {
                "path": "$.quantity",
                "equals": 5
              },
              {
                "path": "$.line_total",
                "equals": 24.95
              }
            ]
          }
        },
        {
          "name": "Get cart and verify single merged line",
          "request": {
            "method": "GET",
            "path": "/cart"
          },
          "expect": {
            "status": 200,
            "json": [
              {
                "path": "$.items",
                "length": 1
              },
              {
                "path": "$.items[0].product_id",
                "equals": "P-1"
              },
              {
                "path": "$.items[0].quantity",
                "equals": 5
              }
            ]
          }
        }
      ]
    },
