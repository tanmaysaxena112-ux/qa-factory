{
  "schema": "qa.webtests.v1",
  "project": "demo-shop",
  "tests": [
    {
      "test_id": "WEB-CART-01",
      "oracle": "AC-001.1",
      "title": "Site root shows page titled and headed \"Demo Shop\"",
      "steps": [
        {
          "action": "goto",
          "path": "/"
        },
        {
          "action": "expect_text",
          "target": {
            "role": "heading",
            "name": "Demo Shop"
          },
          "value": "Demo Shop"
        }
      ]
    },
    {
      "test_id": "WEB-CART-02",
      "oracle": "AC-001.2",
      "title": "Site root shows \"Products\" and \"Cart\" headings",
      "steps": [
        {
          "action": "goto",
          "path": "/"
        },
        {
          "action": "expect_visible",
          "target": {
            "role": "heading",
            "name": "Products"
          }
        },
        {
          "action": "expect_visible",
          "target": {
            "role": "heading",
            "name": "Cart"
          }
        }
      ]
    },
    {
