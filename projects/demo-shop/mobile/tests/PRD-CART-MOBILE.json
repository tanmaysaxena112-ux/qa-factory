{
  "schema": "qa.mobiletests.v1",
  "project": "demo-shop",
  "tests": [
    {
      "test_id": "MOB-CART-01",
      "oracle": "AC-001.1",
      "title": "Portrait layout shows Products above Cart in one column",
      "steps": [
        {
          "action": "goto",
          "path": "/"
        },
        {
          "action": "expect_stacked",
          "target": {
            "role": "region",
            "name": "Products"
          },
          "second": {
            "role": "region",
            "name": "Cart"
          }
        }
      ]
    },
    {
      "test_id": "MOB-CART-04",
      "oracle": "AC-002.2",
      "title": "Adding a product completes correctly in landscape",
      "steps": [
        {
          "action": "rotate",
          "orientation": "landscape"
        },
        {
          "action": "goto",
          "path": "/"
        },
        {
          "action": "fill",
          "target": {
            "label": "Quantity for Notebook"
          },
          "value": "3"
        },
        {
          "action": "tap",
          "target": {
            "role": "button",
            "name": "Add Notebook to cart"
          }
        },
        {
          "action": "expect_contains",
          "target": {
            "role": "region",
            "name": "Cart"
          },
          "value": "Notebook × 3"
        },
        {
          "action": "expect_contains",
          "target": {
            "role": "region",
            "name": "Cart"
          },
          "value": "$14.97"
        }
      ]
    },
    {
      "test_id": "MOB-CART-05",
