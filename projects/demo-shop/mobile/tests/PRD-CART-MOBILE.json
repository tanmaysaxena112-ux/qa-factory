    {
      "test_id": "MOB-CART-06",
      "oracle": "EC-002.1",
      "title": "Rotating the device preserves cart, unsent quantity and shown message",
      "steps": [
        {
          "action": "goto",
          "path": "/"
        },
        {
          "action": "fill",
          "target": {
            "label": "Quantity for Notebook"
          },
          "value": "2"
        },
        {
          "action": "tap",
          "target": {
            "role": "button",
            "name": "Add Notebook to cart"
          }
        },
        {
          "action": "expect_contains",
          "target": {
            "role": "region",
            "name": "Cart"
          },
          "value": "Notebook × 2"
        },
        {
          "action": "fill",
          "target": {
            "label": "Quantity for Notebook"
          },
          "value": "11"
        },
        {
          "action": "tap",
          "target": {
            "role": "button",
            "name": "Add Notebook to cart"
          }
        },
        {
          "action": "expect_text",
          "target": {
            "role": "alert"
          },
          "value": "Quantity must be a whole number from 1 to 10."
        },
        {
          "action": "fill",
          "target": {
            "label": "Quantity for Backpack"
          },
          "value": "4"
        },
        {
          "action": "rotate",
          "orientation": "landscape"
        },
        {
          "action": "expect_contains",
          "target": {
            "role": "region",
            "name": "Cart"
          },
          "value": "Notebook × 2"
        },
        {
          "action": "expect_text",
          "target": {
            "role": "alert"
          },
          "value": "Quantity must be a whole number from 1 to 10."
        },
        {
          "action": "expect_value",
          "target": {
            "label": "Quantity for Backpack"
          },
          "value": "4"
        }
      ]
    },
