{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa.edgecases.v1",
  "title": "Edge Case Hunter output: missed scenarios become cases that cite a criterion, or open questions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "prd_id", "proposals"],
  "properties": {
    "schema": { "const": "qa.edgecases.v1" },
    "prd_id": { "type": "string", "pattern": "^PRD-[A-Z0-9]+(-[A-Z0-9]+)*$" },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["technique", "requirement", "scenario", "outcome"],
        "properties": {
          "technique": { "type": "string", "minLength": 1 },
          "requirement": { "type": "string", "pattern": "^REQ-[0-9]{3}$" },
          "scenario": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "enum": ["new_case", "open_question", "already_covered"] },
          "case": { "$ref": "qa.cases.v1#/$defs/case" },
          "question": { "type": "string", "minLength": 1 },
          "covered_by": { "type": "array", "items": { "type": "string" } }
        },
        "allOf": [
          { "if": { "type": "object", "properties": { "outcome": { "const": "new_case" } } }, "then": { "type": "object", "required": ["case"], "properties": { "case": { "type": "object" } } } },
          { "if": { "type": "object", "properties": { "outcome": { "const": "open_question" } } }, "then": { "type": "object", "required": ["question"], "properties": { "question": { "type": "string" } } } },
          { "if": { "type": "object", "properties": { "outcome": { "const": "already_covered" } } }, "then": { "type": "object", "required": ["covered_by"], "properties": { "covered_by": { "type": "array", "minItems": 1 } } } }
        ]
      }
    }
  }
}
