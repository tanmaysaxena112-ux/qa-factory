{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa.finding.v1",
  "title": "Defect candidate. Every field cites evidence or reads UNKNOWN.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "finding_id", "run_id", "title", "test_ids", "cause", "severity", "steps_to_reproduce", "expected", "actual", "evidence"],
  "properties": {
    "schema": { "const": "qa.finding.v1" },
    "finding_id": { "type": "string", "pattern": "^F-[0-9]{2,}$" },
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{4}-[0-9]{4}-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "test_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(API|WEB|MOB)-[A-Z0-9]+-[0-9]{2,}$" }
    },
    "requirement": { "type": "string", "pattern": "^(REQ-[0-9]{3}|UNKNOWN)$" },
    "cause": { "type": "string", "enum": ["product_defect", "pre_existing", "environment", "incomplete", "UNKNOWN"] },
    "cause_evidence": { "type": "string" },
    "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "UNKNOWN"] },
    "steps_to_reproduce": {
      "oneOf": [
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        { "type": "string", "const": "UNKNOWN" }
      ]
    },
    "expected": { "type": "string", "minLength": 1 },
    "actual": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "cluster_id": { "type": "string", "pattern": "^RC-[0-9]{4}-[0-9]{4}-[0-9]{2}$" }
  },
  "if": { "type": "object", "properties": { "cause": { "const": "environment" } } },
  "then": { "type": "object", "required": ["cause_evidence"], "properties": { "cause_evidence": { "type": "string", "minLength": 1 } } }
}
