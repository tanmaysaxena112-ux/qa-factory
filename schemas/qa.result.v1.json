{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa.result.v1",
  "title": "One test result, written by a runner. PASS and FAIL must cite at least one artefact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "test_id", "surface", "status", "artefacts"],
  "properties": {
    "schema": { "const": "qa.result.v1" },
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{4}-[0-9]{4}-[0-9]{3}$" },
    "test_id": { "type": "string", "pattern": "^(API|WEB|MOB)-[A-Z0-9]+-[0-9]{2,}$" },
    "surface": { "type": "string", "enum": ["api", "web", "mobile"] },
    "status": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "FLAKY"] },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "blocked_reason": { "type": "string" },
    "artefacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/snapshot" },
        "end": { "$ref": "#/$defs/snapshot" }
      }
    }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "status": { "enum": ["PASS", "FAIL", "FLAKY"] } } },
      "then": { "type": "object", "properties": { "artefacts": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "type": "object", "properties": { "status": { "const": "BLOCKED" } } },
      "then": { "type": "object", "required": ["blocked_reason"], "properties": { "blocked_reason": { "type": "string", "minLength": 1 } } }
    }
  ],
  "$defs": {
    "snapshot": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["up", "down", "degraded", "unknown"] }
        }
      }
    }
  }
}
