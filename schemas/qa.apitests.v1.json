{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa.apitests.v1",
  "title": "Declarative API tests. Data only: no scripts, so every test is deterministic and reviewable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "tests"],
  "properties": {
    "schema": { "const": "qa.apitests.v1" },
    "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "tests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/test" } }
  },
  "$defs": {
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_id", "oracle", "title", "steps"],
      "properties": {
        "test_id": { "type": "string", "pattern": "^API-[A-Z0-9]+-[0-9]{2,}$" },
        "oracle": { "type": "string", "pattern": "^(AC|EC)-[0-9]{3}\\.[0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "request", "expect"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path"],
          "properties": {
            "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
            "path": { "type": "string", "pattern": "^/" },
            "body": {},
            "raw_body": { "type": "string" }
          }
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "type": "integer", "minimum": 100, "maximum": 599 },
            "contract": { "type": "boolean" },
            "json": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path"],
                "properties": {
                  "path": { "type": "string", "pattern": "^\\$(\\.[A-Za-z_][A-Za-z0-9_]*|\\[[0-9]+\\])*$" },
                  "equals": {},
                  "exists": { "type": "boolean" },
                  "contains": {},
                  "length": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    }
  }
}
