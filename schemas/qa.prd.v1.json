{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa.prd.v1",
  "title": "Machine index of a PRD, generated from the Markdown PRD, never hand-edited",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "prd_id", "project", "title", "status", "requirements"],
  "properties": {
    "schema": { "const": "qa.prd.v1" },
    "prd_id": { "type": "string", "pattern": "^PRD-[A-Z0-9]+(-[A-Z0-9]+)*$" },
    "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "in_review", "approved", "superseded"] },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "risk", "acceptance_criteria"],
      "properties": {
        "id": { "type": "string", "pattern": "^REQ-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "enum": ["high", "medium", "low"] },
        "risk_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["money", "auth", "data_loss", "compliance"] }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/item", "type": "object", "properties": { "id": { "type": "string", "pattern": "^AC-[0-9]{3}\\.[0-9]+$" } } }
        },
        "edge_cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/item", "type": "object", "properties": { "id": { "type": "string", "pattern": "^EC-[0-9]{3}\\.[0-9]+$" } } }
        },
        "open_questions": {
          "type": "array",
          "items": { "$ref": "#/$defs/item", "type": "object", "properties": { "id": { "type": "string", "pattern": "^OQ-[0-9]{3}\\.[0-9]+$" } } }
        },
        "superseded_by": { "type": "string", "pattern": "^REQ-[0-9]{3}$" }
      },
      "if": { "type": "object", "properties": { "risk": { "const": "high" } } },
      "then": { "type": "object", "required": ["risk_reasons"], "properties": { "risk_reasons": { "type": "array", "minItems": 1 } } }
    },
    "item": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string", "minLength": 1 }
      }
    }
  }
}
